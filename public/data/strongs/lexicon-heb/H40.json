{"H4001":{"lemma":"מְבוּסָה","xlit":"mᵉbûwçâh","gloss":"treading (trodden) down (under foot).","def":"a trampling"},"H4002":{"lemma":"מַבּוּעַ","xlit":"mabbûwaʻ","gloss":"fountain, spring.","def":"a fountain"},"H4003":{"lemma":"מְבוּקָה","xlit":"mᵉbûwqâh","gloss":"void.","def":"emptiness"},"H4004":{"lemma":"מִבְחוֹר","xlit":"mibchôwr","gloss":"choice.","def":"select, i.e. well fortified"},"H4005":{"lemma":"מִבְחָר","xlit":"mibchâr","gloss":"choice(-st), chosen.","def":"select, i.e. best"},"H4006":{"lemma":"מִבְחָר","xlit":"Mibchâr","gloss":"Mibhar.","def":"Mibchar, an Israelite"},"H4007":{"lemma":"מַבָּט","xlit":"mabbâṭ","gloss":"expectation.","def":"something expected, i.e. (abstractly) expectation"},"H4008":{"lemma":"מִבְטָא","xlit":"mibṭâʼ","gloss":"(that which...) uttered (out of).","def":"a rash utterance (hasty vow)"},"H4009":{"lemma":"מִבְטָח","xlit":"mibṭâch","gloss":"confidence, hope, sure, trust.","def":"properly, a refuge, i.e. (objective) security, or (subjective) assurance"},"H4010":{"lemma":"מַבְלִיגִית","xlit":"mablîygîyth","gloss":"comfort self.","def":"desistance (or rather desolation)"},"H4011":{"lemma":"מִבְנֶה","xlit":"mibneh","gloss":"frame.","def":"a building"},"H4012":{"lemma":"מְבֻנַּי","xlit":"Mᵉbunnay","gloss":"Mebunnai.","def":"Mebunnai, an Israelite"},"H4013":{"lemma":"מִבְצָר","xlit":"mibtsâr","gloss":"(de-, most) fenced, fortress, (most) strong (hold).","def":"a fortification, castle, or fortified city; figuratively, a defender"},"H4014":{"lemma":"מִבְצָר","xlit":"Mibtsâr","gloss":"Mibzar.","def":"Mibtsar, an Idumaean"},"H4015":{"lemma":"מִבְרָח","xlit":"mibrâch","gloss":"fugitive.","def":"a refugee"},"H4016":{"lemma":"מָבֻשׁ","xlit":"mâbush","gloss":"secrets.","def":"(plural) the (male) pudenda"},"H4017":{"lemma":"מִבְשָׂם","xlit":"Mibsâm","gloss":"Mibsam.","def":"Mibsam, the name of an Ishmaelite and of an Israelite"},"H4018":{"lemma":"מְבַשְּׁלָה","xlit":"mᵉbashshᵉlâh","gloss":"boiling-place.","def":"a cooking hearth"},"H4019":{"lemm