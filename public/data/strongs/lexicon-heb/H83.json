{"H8300":{"lemma":"שָׂרִיד","xlit":"sârîyd","gloss":"[idiom] alive, left, remain(-ing), remnant, rest.","def":"a survivor"},"H8301":{"lemma":"שָׂרִיד","xlit":"Sârîyd","gloss":"Sarid.","def":"Sarid, a place in Palestine"},"H8302":{"lemma":"שִׁרְיוֹן","xlit":"shiryôwn","gloss":"breastplate, coat of mail, habergeon, harness. See H5630 (סִרְיֹן).","def":"a corslet (as if twisted)"},"H8303":{"lemma":"שִׁרְיוֹן","xlit":"Shiryôwn","gloss":"Sirion.","def":"Shirjon or Sirjon, a peak of the Lebanon"},"H8304":{"lemma":"שְׂרָיָה","xlit":"Sᵉrâyâh","gloss":"Seraiah.","def":"Serajah, the name of nine Israelites"},"H8305":{"lemma":"שְׂרִיקָה","xlit":"sᵉrîyqâh","gloss":"fine.","def":"hetchelling (or combing flax), i.e. (concretely) tow (by extension, linen cloth)"},"H8306":{"lemma":"שָׁרִיר","xlit":"shârîyr","gloss":"navel.","def":"a cord, i.e. (by analogy) sinew"},"H8307":{"lemma":"שְׁרִירוּת","xlit":"shᵉrîyrûwth","gloss":"imagination, lust.","def":"obstinacy"},"H8308":{"lemma":"שָׂרַךְ","xlit":"sârak","gloss":"traverse.","def":"to interlace"},"H8309":{"lemma":"שְׁרֵמָה","xlit":"shᵉrêmâh","gloss":"field.","def":"a common"},"H8310":{"lemma":"שַׂרְסְכִים","xlit":"Sarçᵉkîym","gloss":"Sarsechim.","def":"Sarsekim, a Babylonian general"},"H8311":{"lemma":"שָׂרַע","xlit":"sâraʻ","gloss":"stretch out self, (have any) superfluous thing.","def":"to prolong, i.e. (reflex) be deformed by excess of members"},"H8312":{"lemma":"שַׂרְעַף","xlit":"sarʻaph","gloss":"thought.","def":"cogitation"},"H8313":{"lemma":"שָׂרַף","xlit":"sâraph","gloss":"(cause to, make a) burn((-ing), up) kindle, [idiom] utterly.","def":"to be (causatively, set) on fire"},"H8314":{"lemma":"שָׂרָף","xlit":"sârâph","gloss":"fiery (serpent), seraph.","def":"burning, i.e. (figuratively) poisonous (serpent); specifically, a saraph or symbolical creature (from their copper color)"},"H8315":{"lemma":"שָׂרָף","xlit":"Sârâph","gloss":"Saraph.","def":"Saraph, an Israelite"},"H8316":{"lemma":"שְׂרֵפָה","xlit":"sᵉrêphâh","gloss":"burning.","def":"cremation"},"H8317":{"lemma":"שָׁרַץ","xlit":"shârats","gloss":"breed (bring forth, increase) abundantly (in abundance), creep, move.","def":"to wriggle, i.e. (by implication) swarm or abound"},"H8318":{"lemma":"שֶׁרֶץ","xlit":"sherets","gloss":"creep(-ing thing), move(-ing creature).","def":"a swarm, i.e. active mass of minute animals"},"H8319":{"lemma":"שָׁרַק","xlit":"shâraq","gloss":"hiss.","def":"properly, to be shrill, i.e. to whistle or hiss (as a call or in scorn)"},"H8320":{"lemma":"שָׂרֻק","xlit":"sâruq","gloss":"speckled. See H8291 (שָׂרוּק).","def":"bright red (as piercing to the sight), i.e. bay"},"H8321":{"lemma":"שֹׂרֵק","xlit":"sôrêq","gloss":"choice(-st, noble) wine. Compare H8291 (שָׂרוּק).","def":"a vine stock (properly, one yielding purple grapes, the richest variety)"},"H8322":{"lemma":"שְׁרֵקָה","xlit":"shᵉrêqâh","gloss":"hissing.","def":"a derision"},"H8323":{"lemma":"שָׂרַר","xlit":"sârar","gloss":"[idiom] altogether, make self a prince, (bear) rule.","def":"to have (transitively, exercise; reflexively, get) dominion"},"H8324":{"lemma":"שָׁרַר","xlit":"shârar","gloss":"enemy.","def":"to be hostile (only active participle an opponent)"},"H8325":{"lemma":"שָׁרַר","xlit":"Shârar","gloss":"Sharar.","def":"Sharar, an Israelite"},"H8326":{"lemma":"שֹׁרֶר","xlit":"shôrer","gloss":"navel.","def":"the umbilical cord, i.e. (by extension) a bodice"},"H8327":{"lemma":"שָׁרַשׁ","xlit":"shârash","gloss":"(take, cause to take) root (out).","def":"to root, i.e. strike into the soil, or (by implication) to pluck from it"},"H8328":{"lemma":"שֶׁרֶשׁ","xlit":"sheresh","gloss":"bottom, deep, heel, root.","def":"a root (literally or figuratively)"},"H8329":{"lemma":"שֶׁרֶשׁ","xlit":"Sheresh","gloss":"Sharesh.","def":"Sheresh, an Israelite"},"H8330":{"lemma":"שֹׁרֶשׁ","xlit":"shôresh","gloss":"root.","def":"{a root (literally or figuratively)}"},"H8331":{"lemma":"שַׁרְשָׁה","xlit":"sharshâh","gloss":"chain. Compare H8333 (שַׁרְשְׁרָה).","def":"a chain (as rooted, i.e. linked)"},"H8332":{"lemma":"שְׁרֹשׁוּ","xlit":"shᵉrôshûw","gloss":"banishment.","def":"eradication, i.e. (figuratively) exile"},"H8333":{"lemma":"שַׁרְשְׁרָה","xlit":"sharshᵉrâh","gloss":"chain.","def":"a chain; (architectural) probably a garland"},"H8334":{"lemma":"שָׁרַת","xlit":"shârath","gloss":"minister (unto), (do) serve(-ant, -ice, -itor), wait on.","def":"to attend as a menial or worshipper; figuratively, to contribute to"},"H8335":{"lemma":"שָׁרֵת","xlit":"shârêth","gloss":"minister(-ry).","def":"service (in the Temple)"},"H8336":{"lemma":"שֵׁשׁ","xlit":"shêsh","gloss":"[idiom] blue, fine (twined) linen, marble, silk.","def":"bleached stuff, i.e. white linen or (by analogy) marble"},"H8337":{"lemma":"שֵׁשׁ","xlit":"shêsh","gloss":"six(-teen, -teenth), sixth.","def":"six (as an overplus  beyond five or the fingers of the hand); as ord. sixth"},"H8338":{"lemma":"שָׁשָׁא","xlit":"shâshâʼ","gloss":"leave by the sixth part (by confusion with H8341 (שָׁשָׁה)).","def":"to annihilate"},"H8339":{"lemma":"שֵׁשְׁבַּצַּר","xlit":"Shêshᵉbatstsar","gloss":"Sheshbazzar.","def":"Sheshbatstsar, Zerubbabel's Persian name"},"H8340":{"lemma":"שֵׁשְׁבַּצַּר","xlit":"Shêshᵉbatstsar","gloss":"Sheshbazzar.","def":"{Sheshbatstsar, Zerubbabel's Persian name}"},"H8341":{"lemma":"שָׁשָׁה","xlit":"shâshâh","gloss":"give the sixth participle","def":"to sixth or divide into sixths"},"H8342":{"lemma":"שָׂשׂוֹן","xlit":"sâsôwn","gloss":"gladness, joy, mirth, rejoicing.","def":"cheerfulness; specifically, welcome"},"H8343":{"lemma":"שָׁשַׁי","xlit":"Shâshay","gloss":"Shashai.","def":"Shashai, an Israelite"},"H8344":{"lemma":"שֵׁשַׁי","xlit":"Shêshay","gloss":"Sheshai.","def":"Sheshai, a Canaanite"},"H8345":{"lemma":"שִׁשִּׁי","xlit":"shishshîy","gloss":"sixth (part).","def":"sixth, ord. or (feminine) fractional"},"H8346":{"lemma":"שִׁשִּׁים","xlit":"shishshîym","gloss":"sixty, three score.","def":"sixty"},"H8347":{"lemma":"שֵׁשַׁךְ","xlit":"Shêshak","gloss":"Sheshach.","def":"Sheshak, a symbolic name of Babylon"},"H8348":{"lemma":"שֵׁשָׁן","xlit":"Shêshân","gloss":"Sheshan.","def":"Sheshan, an Israelite"},"H8349":{"lemma":"שָׁשַׁק","xlit":"Shâshaq","gloss":"Shashak.","def":"Shashak, an Israelite"},"H8350":{"lemma":"שָׁשַׁר","xlit":"shâshar","gloss":"vermillion.","def":"red ochre (from its piercing color)"},"H8351":{"lemma":"שֵׁת","xlit":"shêth","gloss":"Sheth.","def":"tumult"},"H8352":{"lemma":"שֵׁת","xlit":"Shêth","gloss":"Seth, Sheth.","def":"Sheth, third son of Adam"},"H8353":{"lemma":"שֵׁת","xlit":"shêth","gloss":"six(-th).","def":"{six}"},"H8354":{"lemma":"שָׁתָה","xlit":"shâthâh","gloss":"[idiom] assuredly, banquet, [idiom] certainly, drink(-er, -ing), drunk ([idiom] -ard), surely. (Prop. intensive of H8248 (שָׁקָה).)","def":"to imbibe (literally or figuratively)"},"H8355":{"lemma":"שְׁתָה","xlit":"shᵉthâh","gloss":"drink.","def":"{to imbibe (literally or figuratively)}"},"H8356":{"lemma":"שָׁתָה","xlit":"shâthâh","gloss":"foundation, purpose.","def":"a basis, i.e. (figuratively) political or moral support"},"H8357":{"lemma":"שֵׁתָה","xlit":"shêthâh","gloss":"buttock.","def":"the seat (of the person)"},"H8358":{"lemma":"שְׁתִי","xlit":"shᵉthîy","gloss":"drunkenness.","def":"intoxicaion"},"H8359":{"lemma":"שְׁתִי","xlit":"shᵉthîy","gloss":"warp.","def":"a fixture, i.e. the warp in weaving"},"H8360":{"lemma":"שְׁתִיָּה","xlit":"shᵉthîyâh","gloss":"drinking.","def":"potation"},"H8361":{"lemma":"שִׁתִּין","xlit":"shittîyn","gloss":"threescore.","def":"sixty"},"H8362":{"lemma":"שָׁתַל","xlit":"shâthal","gloss":"plant.","def":"to transplant"},"H8363":{"lemma":"שְׁתִל","xlit":"shᵉthil","gloss":"plant.","def":"a sprig (as if transplanted), i.e. sucker"},"H8364":{"lemma":"שֻׁתַלְחִי","xlit":"Shuthalchîy","gloss":"Shuthalhites.","def":"a Shuthalchite (collectively) or descendants of Shuthelach"},"H8365":{"lemma":"שָׁתַם","xlit":"shâtham","gloss":"be open.","def":"to unveil (figuratively)"},"H8366":{"lemma":"שָׁתַן","xlit":"shâthan","gloss":"piss.","def":"(causatively) to make water, i.e. urinate"},"H8367":{"lemma":"שָׁתַק","xlit":"shâthaq","gloss":"be calm, cease, be quiet.","def":"to subside"},"H8368":{"lemma":"שָׂתַר","xlit":"sâthar","gloss":"have in (one's) secret parts.","def":"to break out (as an eruption)"},"H8369":{"lemma":"שֵׁתָר","xlit":"Shêthâr","gloss":"Shethar.","def":"Shethar, a Persian satrap"},"H8370":{"lemma":"שְׁתַר בּוֹזְנַי","xlit":"Shᵉthar Bôwzᵉnay","gloss":"Shetharboznai.","def":"Shethar-Bozenai, a Persian officer"},"H8371":{"lemma":"שָׁתַת","xlit":"shâthath","gloss":"be laid, set. t","def":"to place, i.e. array; reflex. to lie"},"H8372":{"lemma":"תָּא","xlit":"tâʼ","gloss":"(little) chamber.","def":"a room (as circumscribed)"},"H8373":{"lemma":"תָּאַב","xlit":"tâʼab","gloss":"long.","def":"to desire"},"H8374":{"lemma":"תָּאַב","xlit":"tâʼab","gloss":"abhor.","def":"to loathe (morally)"},"H8375":{"lemma":"תַּאֲבָה","xlit":"taʼăbâh","gloss":"longing.","def":"desire"},"H8376":{"lemma":"תָּאָה","xlit":"tâʼâh","gloss":"point out.","def":"to mark off, i.e. (intensively) designate"},"H8377":{"lemma":"תְּאוֹ","xlit":"tᵉʼôw","gloss":"wild bull (ox).","def":"a species of antelope (probably from the white stripe on the cheek)"},"H8378":{"lemma":"תַּאֲוָה","xlit":"taʼăvâh","gloss":"dainty, desire, [idiom] exceedingly, [idiom] greedily, lust(ing), pleasant. See also H6914 (קִבְרוֹת הַתַּאֲוָה).","def":"a longing; by implication, a delight (subjectively, satisfaction, objectively, a charm)"},"H8379":{"lemma":"תַּאֲוָה","xlit":"taʼăvâh","gloss":"utmost bound.","def":"a limit, i.e. full extent"},"H8380":{"lemma":"תָּאוֹם","xlit":"tâʼôwm","gloss":"twins.","def":"a twin (in plural only), literally or figuratively"},"H8381":{"lemma":"תַּאֲלָה","xlit":"taʼălâh","gloss":"curse.","def":"an imprecation"},"H8382":{"lemma":"תָּאַם","xlit":"tâʼam","gloss":"coupled (together), bear twins.","def":"to be (causatively, make) twinned, i.e. (figuratively) duplicate or (architectural) jointed"},"H8383":{"lemma":"תְּאֻן","xlit":"tᵉʼun","gloss":"lie.","def":"naughtiness, i.e. toil"},"H8384":{"lemma":"תְּאֵן","xlit":"tᵉʼên","gloss":"fig (tree).","def":"the fig (tree or fruit)"},"H8385":{"lemma":"תַּאֲנָה","xlit":"taʼănâh","gloss":"occasion.","def":"an opportunity or (subjectively) purpose"},"H8386":{"lemma":"תַּאֲנִיָּה","xlit":"taʼănîyâh","gloss":"heaviness, mourning.","def":"lamentation"},"H8387":{"lemma":"תַּאֲנַת שִׁלֹה","xlit":"Taʼănath Shilôh","gloss":"Taanath-shiloh.","def":"Taanath-Shiloh, a place in Palestine"},"H8388":{"lemma":"תָּאַר","xlit":"tâʼar","gloss":"be drawn, mark out, (Rimmon-) methoar (by union with H7417 (רִמּוֹן)).","def":"to delineate; reflex. to extend"},"H8389":{"lemma":"תֹּאַר","xlit":"tôʼar","gloss":"[phrase] beautiful, [idiom] comely, countenance, [phrase] fair, [idiom] favoured, form, [idiom] goodly, [idiom] resemble, visage.","def":"outline, i.e. figure or appearance"},"H8390":{"lemma":"תַּאֲרֵעַ","xlit":"Taʼărêaʻ","gloss":"Tarea. See H8475 (תַּחְרֵעַ).","def":"Taarea, an Israelite"},"H8391":{"lemma":"תְּאַשּׁוּר","xlit":"tᵉʼashshûwr","gloss":"box (tree).","def":"a species of cedar (from its erectness)"},"H8392":{"lemma":"תֵּבָה","xlit":"têbâh","gloss":"ark.","def":"a box"},"H8393":{"lemma":"תְּבוּאָה","xlit":"tᵉbûwʼâh","gloss":"fruit, gain, increase, revenue.","def":"income, i.e. produce (literally or figuratively)"},"H8394":{"lemma":"תָּבוּן","xlit":"tâbûwn","gloss":"discretion, reason, skilfulness, understanding, wisdom.","def":"intelligence; by implication, an argument; by extension, caprice"},"H8395":{"lemma":"תְּבוּסָה","xlit":"tᵉbûwçâh","gloss":"destruction.","def":"a treading down, i.e. ruin"},"H8396":{"lemma":"תָּבוֹר","xlit":"Tâbôwr","gloss":"Tabor.","def":"Tabor, a mountain in Palestine, also a city adjacent"},"H8397":{"lemma":"תֶּבֶל","xlit":"tebel","gloss":"confusion.","def":"mixture, i.e. unnatural bestiality"},"H8398":{"lemma":"תֵּבֵל","xlit":"têbêl","gloss":"habitable part, world.","def":"the earth (as moist and therefore inhabited); by extension, the globe; by implication, its inhabitants; specifically, a particular land, as Babylonia, Palestine"},"H8399":{"lemma":"תַּבְלִית","xlit":"tablîyth","gloss":"destruction.","def":"consumption"}}