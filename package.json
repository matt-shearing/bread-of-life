{
  "name": "bread-of-life",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "A warm, offline-first homebase for Bible reading, prayer, and journalling.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"scripts/test-*.mjs\" scripts/verify-plans.mjs",
    "fetch:bible": "node scripts/fetch-bible.mjs",
    "build:versification": "node scripts/build-versification.mjs",
    "verify:plans": "node scripts/verify-plans.mjs",
    "test:reminders": "node scripts/test-reading-reminders.mjs",
    "test:devotional-speech": "node scripts/test-devotional-speech.mjs",
    "test:audio-url": "node --test-reporter=spec scripts/test-audio-url.mjs",
    "test:audio": "node --test-reporter=spec scripts/test-audio-queue.mjs",
    "test:sync": "node --test-reporter=spec scripts/test-sync.mjs",
    "test:backup": "node --test-reporter=spec scripts/test-backup.mjs",
    "test:sync-server": "node --test-reporter=spec scripts/test-sync-server.mjs",
    "test:reference": "node --test-reporter=spec scripts/test-reference.mjs",
    "build:crossrefs": "node scripts/build-crossrefs.mjs",
    "build:strongs": "node scripts/build-strongs.mjs",
    "build:devotional": "node scripts/build-devotional.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/merriweather": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.16",
    "fflate": "0.8.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.3"
  }
