# Copy to .env and fill in. See README.md.

# The public name Caddy serves and gets a TLS certificate for.
SYNC_DOMAIN=sync.example.org
# Contact address for Let's Encrypt.
ACME_EMAIL=you@example.org
# Signs login tokens. Long, random and stable: openssl rand -hex 32
# Changing it signs every device out. The server won't start without it.
TOKEN_SECRET=

# Optional. Requests per client address per window.
# RATE_EVENTS=300
# RATE_WINDOW=1m
# Optional. Only behind Cloudflare: its IP ranges, space-separated (README lists them),
# so the rate limit keys on the real client address.
# TRUSTED_PROXIES=
# Optional container limits.
# MEMORY_LIMIT=512M
# CPU_LIMIT=1.0
