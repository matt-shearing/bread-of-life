[Unit]
Description=Bread of Life: keep the deck card current while the app is closed

[Timer]
# Every five minutes, plus on the dot at midnight (the date rolls over) and at 17:00 (the
# devotion turns to Evening). Persistent runs a missed tick after a suspend or power-off.
OnCalendar=*:0/5
OnCalendar=*-*-* 00:00:05
OnCalendar=*-*-* 17:00:05
OnStartupSec=30s
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
