{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do on every platform. Desktop-only and Android-only permissions are in desktop.json, android.json and mobile.json.",
  "platforms": [
    "linux",
    "macOS",
    "windows",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://apps.obtainium.imranr.dev/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://\\[\\:\\:1\\]:*/*"
        },
        {
          "url": "http://:ip(10\\.[0-9.]+):*/*"
        },
        {
          "url": "http://:ip(192\\.168\\.[0-9.]+):*/*"
        },
        {
          "url": "http://:ip(172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9.]+):*/*"
        },
        {
          "url": "http://:ip(169\\.254\\.[0-9.]+):*/*"
        },
        {
          "url": "http://:ip(100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.[0-9.]+):*/*"
        },
        {
          "url": "http://:host([A-Za-z0-9-]+):*/*"
        },
        {
          "url": "http://*.local:*/*"
        },
        {
          "url": "http://*.lan:*/*"
        },
        {
          "url": "http://*.home.arpa:*/*"
        },
        {
          "url": "http://*.internal:*/*"
        },
        {
          "url": "http://*.ts.net:*/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    "dialog:allow-open"
  ]
}
