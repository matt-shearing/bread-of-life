{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bread of Life",
  "version": "0.5.0",
  "identifier": "com.breadoflife.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Bread of Life",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https://*.helloao.org https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://*.helloao.org",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/run/media/**",
          "/storage/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Your daily Bible homebase",
    "longDescription": "A warm, offline-first homebase for Bible reading, pluggable commentary, journalling, and an answered-prayer log.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2 | libasound2t64"
        ]
      }
    }
  }
}
